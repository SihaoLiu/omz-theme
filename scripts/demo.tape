Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 20
Set LetterSpacing 0
Set Width 1920
Set Height 360
Set Padding 20
Set Framerate 20
Set TypingSpeed 45ms
Set CursorBlink false
Set Theme { "name": "AI Candy", "black": "#171717", "red": "#ef4444", "green": "#22c55e", "yellow": "#eab308", "blue": "#3b82f6", "magenta": "#d946ef", "cyan": "#06b6d4", "white": "#e5e7eb", "brightBlack": "#525252", "brightRed": "#f87171", "brightGreen": "#4ade80", "brightYellow": "#facc15", "brightBlue": "#60a5fa", "brightMagenta": "#e879f9", "brightCyan": "#22d3ee", "brightWhite": "#fafafa", "background": "#0a0a0a", "foreground": "#e5e7eb", "selection": "#404040", "cursor": "#fafafa" }

Hide
Type "exec ./session.sh"
Enter
Sleep 500ms
Show
Sleep 1200ms

